# Argilla Configuration
ARGILLA_API_URL=https://... # URL of the Argilla instance
ARGILLA_API_KEY=arg.pk...   # API Key for authorization
ARGILLA_WORKSPACE=archaeo_ner_greek # Target workspace
ARGILLA_DATASET=archaeo_ner_greek # Main dataset name
ARGILLA_TEST_DATASET=archaeo_ner_greek_test_set # Test dataset name

# Annotators
DEFAULT_ANNOTATOR=your_username  # Lead annotator for publishing and training
ANNOTATOR_A=your_username        # Used for IAA agreement scripts
ANNOTATOR_B=other_username       # Used for IAA agreement scripts

# Hugging Face
HUGGING_FACE_HUB_TOKEN=hf_... # Write-access token
HF_REPO_ID=username/archaeo-ner-greek # Hugging Face repository ID
HF_REPO_PRIVATE=False # Set to True for private, False for public (Default: False)
HF_REPO_GATED=false # options: manual, auto, false (Default: false)
HF_NOTIFICATION_EMAIL=your-email@example.com

# Weights & Biases Logging (Optional)
WANDB_API_KEY= # Weights & Biases API Key
WANDB_PROJECT=archaeo-ner-greek # WandB Project Name

# Formatting / Exports
EXPORT_LATEX_TABLES=False # Set to True to generate .tex files from notebooks

# LLM APIs for Synthetic Data Generation
GOOGLE_API_KEY= # For free, high-throughput Gemini generation (Gemini API Key)
OPENAI_API_KEY= # For gold evaluations/GPT-4o generation (optional fallback)
OPENAI_BASE_URL=https://openrouter.ai/api/v1 # Base URL for custom gateways or OpenRouter (optional)
OPENAI_MODEL_NAME=gpt-4o # Model name for OpenAI/OpenRouter (optional)

# Synthetic Generation Settings
SYNTHETIC_NUM_BATCHES=3 # Number of generation rounds (batches)
SYNTHETIC_SAMPLES_PER_BATCH=5 # Number of sentences generated per batch
SYNTHETIC_SEED=42 # Random seed for deterministic reproducibility
SYNTHETIC_FLATTEN_SPANS=True # Greedily resolve overlapping/nested spans for flat NER (matching test/dev)
SYNTHETIC_USE_EXTRA_TEXTS=True # Set to True to annotate raw texts in SYNTHETIC_EXTRA_TEXTS_DIR, False to generate from scratch
SYNTHETIC_EXTRA_TEXTS_DIR=data/extra_texts # Path to the raw unannotated text files (relative to repository root)

# GLiNER2 Fine-Tuning Augmentation Settings
USE_SYNTHETIC_DATA=True                     # If set to True, will mix synthetic data into the training split
SYNTHETIC_DATA_PATH=data/synthetic_data_generation/synthetic_archaeology_real_seeded_gemini25flash_n1350.json # Path to the aligned synthetic json dataset
GLINER_SYNTHETIC_RATIO=2.0                  # Dynamic ratio of synthetic to gold data (default 2.0 = 2:1)

# GLiNER2 Fine-Tuning Hyperparameters
GLINER_LORA_R=4                             # LoRA Rank capacity (e.g. 4 for baseline, 8 for medium, 16 for high-capacity)
GLINER_LORA_ALPHA=8.0                       # LoRA Alpha scaling (usually 2 * lora_r)
