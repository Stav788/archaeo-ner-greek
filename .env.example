# Copy to .env and fill in the real values locally.

# Hugging Face
HF_TOKEN=hf_...
HF_REPO_ID=username/archaeo-ner-greek
HUGGING_FACE_HUB_TOKEN=hf_...

# GitHub
GITHUB_USERNAME=your-username

# LLM / OpenAI-compatible API
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_NAME=gpt-4o
GOOGLE_API_KEY=

# WandB logging
WANDB_API_KEY=
WANDB_PROJECT=archaeo-ner-greek

# GLiNER2 training / augmentation
USE_SYNTHETIC_DATA=False
GLINER_SYNTHETIC_RATIO=2.0
GLINER_LORA_R=4
GLINER_LORA_ALPHA=8.0

# Synthetic generation
SYNTHETIC_NUM_BATCHES=3
SYNTHETIC_SAMPLES_PER_BATCH=5
SYNTHETIC_SEED=42
SYNTHETIC_FLATTEN_SPANS=True
SYNTHETIC_EXTRA_TEXTS_DIR=data/extra_texts
